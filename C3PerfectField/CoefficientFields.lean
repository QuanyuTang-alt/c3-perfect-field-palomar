module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-!
Finite coefficient fields and manuscript Lemma `lem:finite-basis`.
`Field.FG` means finite generation as a field over the prime subfield,
not finite generation as an algebra. This distinction allows arbitrary
finite transcendence degree.
-/

@[expose] public section

namespace C3PerfectField

universe u v

variable {k : Type u} [Field k]

/-- The smallest subfield containing the chosen finite list of coefficients. -/
def coefficientField (S : Finset k) : Subfield k :=
  Subfield.closure (S : Set k)

theorem mem_coefficientField {S : Finset k} {c : k} (hc : c ∈ S) :
    c ∈ coefficientField S :=
  Subfield.subset_closure hc

/-- The chosen coefficient field is finitely generated over its own prime
subfield, including when the ambient field has transcendental elements. -/
theorem coefficientField_fg (S : Finset k) : Field.FG (coefficientField S) := by
  classical
  let T : Finset (coefficientField S) :=
    S.attach.map ⟨fun (x : {x : k // x ∈ S}) => ⟨x.1, mem_coefficientField x.2⟩,
      fun x y h => Subtype.ext
        (congrArg (fun z : coefficientField S => (z : k)) h)⟩
  refine ⟨T, ?_⟩
  have hT : (coefficientField S).subtype '' (T : Set (coefficientField S)) =
      (S : Set k) := by
    ext x
    simp only [Set.mem_image, Finset.mem_coe, T, Finset.mem_map, Finset.mem_attach,
      true_and, Subfield.coe_subtype]
    constructor
    · rintro ⟨y, ⟨z, rfl⟩, rfl⟩
      exact z.2
    · intro hx
      exact ⟨⟨x, mem_coefficientField hx⟩, ⟨⟨x, hx⟩, rfl⟩, rfl⟩
  have hm : (Subfield.closure (T : Set (coefficientField S))).map
      (coefficientField S).subtype = coefficientField S := by
    rw [RingHom.map_field_closure, hT]
    rfl
  apply top_unique
  intro x _
  have hx : (x : k) ∈ (Subfield.closure (T : Set (coefficientField S))).map
      (coefficientField S).subtype := hm.symm ▸ x.2
  obtain ⟨y, hy, he⟩ := hx
  have he' : y = x := Subtype.ext he
  exact he' ▸ hy

/-- Fixing the generating coefficients fixes every element of the field
they generate, including inverses and arbitrary field expressions. -/
theorem fixes_coefficientField (S : Finset k) (σ : k ≃+* k)
    (hσ : ∀ c ∈ S, σ c = c) :
    ∀ c ∈ coefficientField S, σ c = c := by
  intro c hc
  exact (Subfield.closure_le.mpr hσ : coefficientField S ≤
    RingHom.eqLocusField σ.toRingHom (RingHom.id k)) hc

/-- The subfield generated by a finite union still fixes every listed
coefficient. This is the common-field step used for a finite module list. -/
theorem exists_common_coefficientField {ι : Type v} [Finite ι]
    (S : ι → Finset k) :
    ∃ F : Subfield k, Field.FG F ∧ ∀ i, ∀ c ∈ S i, c ∈ F := by
  classical
  let := Fintype.ofFinite ι
  let T := Finset.univ.biUnion S
  refine ⟨coefficientField T, coefficientField_fg T, ?_⟩
  intro i c hc
  exact mem_coefficientField (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hc⟩)

variable {P : Type v} [Field P] [Algebra P k]

/-- A finitely generated field is essentially of finite type over every
subfield acting on it, since its field generators still generate over
that larger base. -/
theorem essFiniteType_of_field_fg [Field.FG k] : Algebra.EssFiniteType P k := by
  obtain ⟨s, hs⟩ := (inferInstance : Field.FG k)
  apply IntermediateField.fg_top_iff.mp
  refine ⟨s, top_unique ?_⟩
  intro x _
  have hx : x ∈ Subfield.closure (s : Set k) := hs.symm ▸ Subfield.mem_top x
  exact (Subfield.closure_le.mpr (IntermediateField.subset_adjoin P (s : Set k))) hx

/-- A finitely generated field extension is finite over a finite
transcendence basis, as in manuscript Lemma `lem:finite-basis`. -/
theorem exists_finite_transcendenceBasis [Algebra.EssFiniteType P k] :
    ∃ t : Set k, t.Finite ∧ IsTranscendenceBasis P (fun x : t => x.val) ∧
      FiniteDimensional (IntermediateField.adjoin P t) k := by
  classical
  obtain ⟨s, hs⟩ := IntermediateField.fg_top P k
  have hsa : Algebra.IsAlgebraic (Algebra.adjoin P (s : Set k)) k := by
    rw [← IntermediateField.isAlgebraic_adjoin_iff_top, hs]
    infer_instance
  let := hsa
  obtain ⟨t, hts, ht⟩ := exists_isTranscendenceBasis_subset (R := P) (s : Set k)
  have htf : t.Finite := s.finite_toSet.subset hts
  let : Algebra.IsAlgebraic (IntermediateField.adjoin P t) k := by
    have hr : Set.range (fun x : t => x.val) = t := by
      ext a
      exact ⟨fun ⟨x, hx⟩ => hx ▸ x.2, fun ha => ⟨⟨a, ha⟩, rfl⟩⟩
    have hh := ht.isAlgebraic_field
    change Algebra.IsAlgebraic
      (IntermediateField.adjoin P (Set.range (fun x : t => x.val))) k at hh
    rw [hr] at hh
    exact hh
  let : Algebra.EssFiniteType (IntermediateField.adjoin P t) k :=
    Algebra.EssFiniteType.of_comp P (IntermediateField.adjoin P t) k
  have hfin : FiniteDimensional (IntermediateField.adjoin P t) k :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  exact ⟨t, htf, ht, hfin⟩

/-- In particular the coefficient field has the precise finite-basis
property over its prime field required in the prime-orbit argument. -/
theorem exists_finite_transcendenceBasis_of_fg [Field.FG k] :
    ∃ t : Set k, t.Finite ∧
      IsTranscendenceBasis (⊥ : Subfield k) (fun x : t => x.val) ∧
      FiniteDimensional (IntermediateField.adjoin (⊥ : Subfield k) t) k := by
  let : Algebra.EssFiniteType (⊥ : Subfield k) k :=
    Field.fg_iff_essFiniteType.mp inferInstance
  exact exists_finite_transcendenceBasis

end C3PerfectField
